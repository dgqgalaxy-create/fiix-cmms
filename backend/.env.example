# Copia este archivo a backend/.env y ajusta los valores.
# NUNCA subas .env a GitHub.

DATABASE_URL="postgresql://postgres:TU_CONTRASEÑA@localhost:5432/fiix_cmms?schema=public"
PORT=3000
JWT_SECRET="cambia_este_secreto_jwt"
DEV_MENU_PASSWORD="cambia_esta_clave_dev"

# Opcional
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""
# Horas (0-23, America/Mexico_City) para recordar si el checklist del día no está enviado.
# Por defecto: 10,14,16. Un mensaje por franja como máximo.
# CHECKLIST_REMINDER_HOURS="10,14,16"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# ESCALATION_EMAIL=""

# Web Push (PWA / notificaciones del dispositivo).
# install.sh y update.sh las generan solos si faltan (scripts/ensure-vapid-env.sh).
# Manual: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:mantenimiento@tu-dominio.com"

# Carpeta de respaldos automáticos (pg_dump + uploads). Por defecto: ~/fiix-backups
# (Windows: %USERPROFILE%\fiix-backups). Ejemplo Linux:
# BACKUP_DIR="/home/usuario/fiix-backups"
# Ejemplo Windows:
# BACKUP_DIR="C:\Users\tuusuario\fiix-backups"
