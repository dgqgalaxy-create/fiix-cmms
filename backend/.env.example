# Copia este archivo a backend/.env y ajusta los valores.
# NUNCA subas .env a GitHub.

DATABASE_URL="postgresql://postgres:TU_CONTRASEÑA@localhost:5432/fiix_cmms?schema=public"
PORT=3000
JWT_SECRET="cambia_este_secreto_jwt"
DEV_MENU_PASSWORD="cambia_esta_clave_dev"

# Solo lab/local si usas el default inseguro (NUNCA en planta):
# ALLOW_INSECURE_JWT=1

# Opcional
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""
# Horas (0-23, America/Mexico_City) para recordar si el checklist del día no está enviado.
# Por defecto: 10,14,16. Un mensaje por franja como máximo.
# CHECKLIST_REMINDER_HOURS="10,14,16"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# ESCALATION_EMAIL=""

# Web Push (PWA / notificaciones del dispositivo).
# install.sh y update.sh las generan solos si faltan (scripts/ensure-vapid-env.sh).
# Manual: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:mantenimiento@tu-dominio.com"

# Aviso de actualización (comparar versión desplegada vs GitHub).
# Repo privado: crea un fine-grained PAT con Contents: Read solo a este repo
# y pégalo aquí (o GH_TOKEN). Sin token el banner no puede leer la versión.
# GITHUB_TOKEN=""
# GITHUB_REPO="dgqgalaxy-create/fiix-cmms"
# GITHUB_BRANCH="main"

# Carpeta de respaldos automáticos (pg_dump + uploads). Por defecto: ~/fiix-backups
# (Windows: %USERPROFILE%\fiix-backups). Ejemplo Linux:
# BACKUP_DIR="/home/usuario/fiix-backups"
# Ejemplo Windows:
# BACKUP_DIR="C:\Users\tuusuario\fiix-backups"

# --- Google Sheets (import bajo demanda, Opciones de Desarrollador) ---
# Modo temporal: export CSV público. Ambos Sheets → «Cualquier persona con el enlace → Lector».
# No hace falta cuenta de servicio ni Google Cloud.
# IDs (opcionales; hay defaults GTZ):
# GOOGLE_SHEETS_INVENTORY_ID="1ciJtRqFvIzKYskYGdd6t_MR0r9hml2SUxMkTr6dwp_U"
# GOOGLE_SHEETS_ORDERS_ID="1yApMaUXyhBeMkuJczDOr6mH6f3VdNdcFrctPuSKU1to"
# (Más adelante se puede volver a cuenta de servicio si dejan de ser públicos.)

# --- Google Drive (fotos en import CSV / Sheets) ---
# Carpetas públicas «Cualquiera con el enlace». Requiere API key con Drive API habilitada.
# GOOGLE_DRIVE_API_KEY=""
# GOOGLE_DRIVE_ITEMS_FOLDER="https://drive.google.com/drive/folders/ID_INVENTARIO"
# GOOGLE_DRIVE_WO_FOLDER="https://drive.google.com/drive/folders/ID_ORDENES"
