generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRADOR
  GESTIONADOR
  TECNICO
  OBSERVADOR
}

enum AssetStatus {
  OPERATIVO
  EN_MANTENIMIENTO
  FUERA_DE_SERVICIO
}

/// Sección A–E (legacy / letra MTTO). Preferir ZoneSection + asset.zone_section_id.
enum AssetSection {
  A
  B
  C
  D
  E
}

/// Clasificación patrimonial del activo (letra F/C en el código MTTO).
enum AssetKind {
  FIJO
  CONTROLABLE
}

enum WorkOrderStatus {
  PENDIENTE
  EN_PROCESO
  EN_ESPERA
  FINALIZADO
  ANULADO
}

enum Priority {
  URGENTE
  NORMAL
  BAJO
}

enum MaintenanceType {
  SERVICIO
  PREVENTIVO
  CORRECTIVO
}

enum ProductionGroup {
  A
  B
  C
  D
  NA
}

enum QtyMode {
  INTEGER
  DECIMAL
}

model UnitOfMeasure {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @unique
  is_active        Boolean  @default(true)
  /// Sugerencia al elegir esta UOM en un ítem (el ítem guarda su propio qty_mode).
  default_qty_mode QtyMode  @default(INTEGER)
}

enum FrequencyType {
  DIAS
  SEMANAS
  MESES
  ANUAL
}

model User {
  id                   String      @id @default(uuid()) @db.Uuid
  name                 String
  email                String      @unique
  password_hash        String
  role                 Role
  is_active            Boolean     @default(true)
  must_change_password Boolean     @default(false)
  last_active          DateTime?
  current_path         String?
  created_at           DateTime    @default(now())
  updated_at           DateTime    @updatedAt

  created_orders  WorkOrder[] @relation("CreatedOrders")
  assigned_orders WorkOrder[] @relation("AssignedOrders")
  inventory_transactions InventoryTransaction[]
  created_purchase_orders PurchaseOrder[] @relation("CreatedPurchaseOrders")
  notifications   AppNotification[]
  push_subscriptions PushSubscription[]
  checklist_technician DailyChecklist[] @relation("ChecklistTechnician")
  checklist_leader DailyChecklist[] @relation("ChecklistLeader")
  checklist_transfers_from ChecklistTransfer[] @relation("ChecklistTransferFrom")
  checklist_transfers_to   ChecklistTransfer[] @relation("ChecklistTransferTo")
  checklist_continuation_requests ChecklistContinuationRequest[] @relation("ChecklistContinuationRequester")
  checklist_continuation_resolutions ChecklistContinuationRequest[] @relation("ChecklistContinuationResolver")
  personal_notes PersonalNote[]
  operational_tasks_created OperationalTask[] @relation("OperationalTaskCreator")
  operational_tasks_assigned OperationalTask[] @relation("OperationalTaskAssignee")
  announcements_created GlobalAnnouncement[] @relation("AnnouncementCreator")
  announcement_reads GlobalAnnouncementRead[]
  work_order_comments WorkOrderComment[]
  chat_conversations_created ChatConversation[] @relation("ChatConversationCreator")
  chat_participations ChatParticipant[]
  chat_messages ChatMessage[]

  pattern              TechnicianPattern?
  exceptions           TechnicianException[]
  preferences          Json?       @default("{}")
}

model TechnicianPattern {
  id           String   @id @default(uuid()) @db.Uuid
  user_id      String   @db.Uuid @unique
  user         User     @relation(fields: [user_id], references: [id])
  pattern_type String   // "MIXTO", "4X4_ROTATORIO", "4X4_FIJO"
  start_date   DateTime 
  created_at   DateTime @default(now())
}

model TechnicianException {
  id             String   @id @default(uuid()) @db.Uuid
  user_id        String   @db.Uuid
  user           User     @relation(fields: [user_id], references: [id])
  date           DateTime @db.Date
  exception_type String   // "FALTA", "VACACIONES", "PERMISO_CG", "PERMISO_SG", "TIEMPO_EXTRA", "FESTIVO"
  notes          String?  
  created_at     DateTime @default(now())
}

model Requester {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique
  email       String?
  department  String?
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
}

model Zone {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @unique
  /// Si false, la zona está en modo «Sin secciones» (activos sin sección).
  has_sections  Boolean       @default(true)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  work_orders   WorkOrder[]
  assets        Asset[]
  sections      ZoneSection[]
}

/// Subzona / sección configurable dentro de una zona (p. ej. A–E en L1).
model ZoneSection {
  id         String   @id @default(uuid()) @db.Uuid
  zone_id    String   @db.Uuid
  zone       Zone     @relation(fields: [zone_id], references: [id], onDelete: Cascade)
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  assets     Asset[]

  @@unique([zone_id, name])
  @@index([zone_id])
}

model Asset {
  id              String      @id @default(uuid()) @db.Uuid
  internal_code   String      @unique
  name            String
  brand           String
  model           String
  serial_number   String?
  description     String?
  status          AssetStatus
  /// Letra A–E sincronizada desde ZoneSection.name cuando aplica al código MTTO; null → X.
  section         AssetSection?
  /// Sección/subzona de la zona (nullable = sin sección).
  zone_section_id String?     @db.Uuid
  zone_section    ZoneSection? @relation(fields: [zone_section_id], references: [id], onDelete: SetNull)
  /// Activo fijo (F) o controlable (C); entra en el código MTTO-…-F/C.
  asset_kind      AssetKind   @default(FIJO)

  image_url       String?
  document_url    String?

  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  zone_id         String?     @db.Uuid
  zone            Zone?       @relation(fields: [zone_id], references: [id])
  
  vendor_id       String?     @db.Uuid
  vendor          Vendor?     @relation(fields: [vendor_id], references: [id])
  price           Float?

  work_orders     WorkOrder[]
  maintenance_plans MaintenancePlan[]
  operational_tasks OperationalTask[]
}

model WorkOrder {
  id               String          @id @default(uuid()) @db.Uuid
  folio            Int             @default(autoincrement())
  title            String
  description      String?

  asset_id         String          @db.Uuid
  asset            Asset           @relation(fields: [asset_id], references: [id])

  zone_id          String?         @db.Uuid
  zone             Zone?           @relation(fields: [zone_id], references: [id])

  priority         Priority        @default(NORMAL)
  maintenance_type MaintenanceType @default(CORRECTIVO)
  machine_stopped  Boolean         @default(false)
  requester_name   String?
  production_group ProductionGroup @default(NA)

  status           WorkOrderStatus
  hold_reason      String?
  scheduled_date      DateTime?
  due_date            DateTime?
  started_at          DateTime?
  paused_at           DateTime?
  last_resumed_at     DateTime?
  accumulated_time_ms Int             @default(0)
  resolution_notes    String?
  request_image_url   String?
  before_image_url    String?
  after_image_url     String?

  signature_clean_area String?
  signature_delivery   String?

  created_by_id    String          @db.Uuid
  created_by       User            @relation("CreatedOrders", fields: [created_by_id], references: [id])

  assigned_technicians User[]          @relation("AssignedOrders")

  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  completed_at     DateTime?

  maintenance_plan_id String?      @db.Uuid
  maintenance_plan    MaintenancePlan? @relation("GeneratedOrders", fields: [maintenance_plan_id], references: [id])

  failure_problem_id  String?      @db.Uuid
  failure_problem     FailureProblem? @relation(fields: [failure_problem_id], references: [id])

  failure_cause_id    String?      @db.Uuid
  failure_cause       FailureCause?   @relation(fields: [failure_cause_id], references: [id])

  failure_remedy_id   String?      @db.Uuid
  failure_remedy      FailureRemedy?  @relation(fields: [failure_remedy_id], references: [id])

  sla_events          WorkOrderSlaEvent[]
  inventory_transactions InventoryTransaction[]
  operational_tasks   OperationalTask[]
  comments            WorkOrderComment[]
}

model KPIGoal {
  id               String          @id @default(uuid()) @db.Uuid
  metricKey        String          @unique
  targetValue      Float
  unit             String?
  updated_at       DateTime        @updatedAt
}

model RolePermission {
  id          String   @id @default(uuid()) @db.Uuid
  role        Role     @unique
  permissions Json
  updated_at  DateTime @updatedAt
}

model ItemCategory {
  id          String   @id @default(uuid()) @db.Uuid
  internal_id String   @unique // Ej. "CAT001"
  name        String
  icon_url    String?
  is_active   Boolean  @default(true)
  
  items       Item[]
}

model ItemLocation {
  id          String   @id @default(uuid()) @db.Uuid
  internal_id String   @unique // Ej. "LOC0001"
  name        String
  icon_url    String?
  is_active   Boolean  @default(true)

  items       Item[]
}

model Vendor {
  id          String   @id @default(uuid()) @db.Uuid
  internal_id String   @unique // Ej. "PROV001"
  name        String
  logo_url    String?
  website_url String?
  phone       String?
  email       String?
  address     String?
  is_active   Boolean  @default(true)

  items       Item[]
  purchase_orders PurchaseOrder[]
  assets      Asset[]
}

model Item {
  id                 String          @id @default(uuid()) @db.Uuid
  internal_code      String          @unique // Ej. "MTTO-0001"
  name               String
  description        String?
  image_url          String?
  
  category_id        String?         @db.Uuid
  category           ItemCategory?   @relation(fields: [category_id], references: [id])
  
  vendor_id          String?         @db.Uuid
  vendor             Vendor?         @relation(fields: [vendor_id], references: [id])
  
  location_id        String?         @db.Uuid
  location           ItemLocation?   @relation(fields: [location_id], references: [id])
  
  purchase_cost      Float?
  stock              Float           @default(0)
  minimum_inventory  Float           @default(0)
  is_active          Boolean         @default(true)
  uom                String
  /// Enteros (tornillos) vs decimales (litros/kg). Valida cantidades en movimientos/OT/OC.
  qty_mode           QtyMode         @default(INTEGER)

  inventory_transactions InventoryTransaction[]
  maintenance_plans      PlanItem[]
  purchase_order_items   PurchaseOrderItem[]
}

model InventoryTransaction {
  id          String   @id @default(uuid()) @db.Uuid
  
  item_id     String   @db.Uuid
  item        Item     @relation(fields: [item_id], references: [id])
  
  user_id     String   @db.Uuid
  user        User     @relation(fields: [user_id], references: [id])

  work_order_id String?    @db.Uuid
  work_order    WorkOrder? @relation(fields: [work_order_id], references: [id], onDelete: SetNull)

  /// Idempotencia offline: mismo client_request_id no crea dos salidas.
  client_request_id String? @unique

  unit_cost   Float?   // Costo unitario al momento del consumo (para ligar costo a la OT)
  amount      Float    // Positivo para entradas, negativo para salidas
  reason      String   // Texto libre
  created_at  DateTime @default(now())
}

model MaintenancePlan {
  id                String          @id @default(uuid()) @db.Uuid
  title             String
  description       String?
  
  asset_id          String          @db.Uuid
  asset             Asset           @relation(fields: [asset_id], references: [id])
  
  frequency_type    FrequencyType
  frequency_value   Int             
  
  last_triggered_at DateTime?
  next_due_date     DateTime
  days_in_advance   Int             @default(3)
  
  is_active         Boolean         @default(true)
  
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  generated_orders  WorkOrder[]     @relation("GeneratedOrders")
  required_items    PlanItem[]      
}

model PlanItem {
  id                  String          @id @default(uuid()) @db.Uuid
  maintenance_plan_id String          @db.Uuid
  maintenance_plan    MaintenancePlan @relation(fields: [maintenance_plan_id], references: [id], onDelete: Cascade)
  
  item_id             String          @db.Uuid
  item                Item            @relation(fields: [item_id], references: [id])
  
  quantity_required   Float
}

enum PurchaseOrderStatus {
  BORRADOR
  APROBADA
  ENVIADA
  RECIBIDA
  CANCELADA
}

model PurchaseOrder {
  id              String   @id @default(uuid()) @db.Uuid
  folio           Int      @default(autoincrement())
  
  vendor_id       String   @db.Uuid
  vendor          Vendor   @relation(fields: [vendor_id], references: [id])
  
  status          PurchaseOrderStatus @default(BORRADOR)
  
  created_by_id   String   @db.Uuid
  created_by      User     @relation("CreatedPurchaseOrders", fields: [created_by_id], references: [id])
  
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  expected_date   DateTime?
  received_at     DateTime?

  items           PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id                 String   @id @default(uuid()) @db.Uuid
  
  purchase_order_id  String   @db.Uuid
  purchase_order     PurchaseOrder @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade)
  
  item_id            String   @db.Uuid
  item               Item     @relation(fields: [item_id], references: [id])
  
  quantity           Float
  /// Cantidad realmente recibida al cerrar la OC (null hasta RECIBIDA).
  received_quantity  Float?
  unit_cost          Float    // Precio capturado al crear la orden
}

model FailureProblem {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  causes      FailureCause[]
  work_orders WorkOrder[]
}

model FailureCause {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  problem_id  String   @db.Uuid
  problem     FailureProblem @relation(fields: [problem_id], references: [id], onDelete: Cascade)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  remedies    FailureRemedy[]
  work_orders WorkOrder[]
}

model FailureRemedy {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  cause_id    String   @db.Uuid
  cause       FailureCause @relation(fields: [cause_id], references: [id], onDelete: Cascade)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  work_orders WorkOrder[]
}

model SystemSettings {
  id               String   @id @default(uuid()) @db.Uuid
  /// Contraseña maestra de Opciones de Desarrollador (bcrypt). Si es null, se usa DEV_MENU_PASSWORD del .env.
  dev_menu_password_hash String?
  telegram_enabled   Boolean  @default(true)
  telegram_bot_token String?
  telegram_chat_id   String?
  email_enabled      Boolean  @default(false)
  sla_enabled        Boolean  @default(true)
  sla_policy         Json?
  /// Obsoleto: la interfaz móvil de técnico es preferencia por usuario
  /// (`User.preferences.use_technician_mobile_ui`). Se mantiene por compatibilidad de esquema.
  technician_mobile_ui Boolean @default(true)
  checklist_column_count Int  @default(5)
  updated_at       DateTime @updatedAt
}

enum SlaEventType {
  REMINDER_RESPONSE
  ESCALATE_RESPONSE
  REMINDER_HOLD
  ESCALATE_HOLD
  REMINDER_RESOLUTION
  ESCALATE_RESOLUTION
}

model WorkOrderSlaEvent {
  id            String       @id @default(uuid()) @db.Uuid
  work_order_id String       @db.Uuid
  work_order    WorkOrder    @relation(fields: [work_order_id], references: [id], onDelete: Cascade)
  event_type    SlaEventType
  created_at    DateTime     @default(now())

  @@unique([work_order_id, event_type])
  @@index([work_order_id])
}

model AppNotification {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title      String
  message    String
  link       String?
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
}

/// Suscripción Web Push del navegador/PWA por usuario (opt-in).
model PushSubscription {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  user_agent String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id])
}

enum ChecklistStatus {
  DRAFT
  COMPLETED
  REVIEWED
  NON_COMPLIANCE
}

enum ChecklistTransferStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ChecklistContinuationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ChecklistActivity {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  order       Int      @default(0)
  field_type  String   @default("CHECKBOX") // "CHECKBOX", "NUMBER", "TEXT"
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
}

model DailyChecklist {
  id              String   @id @default(uuid()) @db.Uuid
  date            DateTime @unique @db.Date
  technician_id   String?  @db.Uuid
  technician      User?    @relation("ChecklistTechnician", fields: [technician_id], references: [id])
  leader_id       String?  @db.Uuid
  leader          User?    @relation("ChecklistLeader", fields: [leader_id], references: [id])
  status          ChecklistStatus @default(DRAFT)
  column_count    Int      @default(5)
  non_compliance_at DateTime?
  reopened_from_non_compliance Boolean @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  rows            DailyChecklistRow[]
  transfers       ChecklistTransfer[]
  continuation_requests ChecklistContinuationRequest[]
}

/// Traspaso de responsabilidad de un checklist DRAFT reclamado.
model ChecklistTransfer {
  id           String                  @id @default(uuid()) @db.Uuid
  checklist_id String                  @db.Uuid
  checklist    DailyChecklist          @relation(fields: [checklist_id], references: [id], onDelete: Cascade)
  from_user_id String                  @db.Uuid
  from_user    User                    @relation("ChecklistTransferFrom", fields: [from_user_id], references: [id])
  to_user_id   String                  @db.Uuid
  to_user      User                    @relation("ChecklistTransferTo", fields: [to_user_id], references: [id])
  status       ChecklistTransferStatus @default(PENDING)
  note         String?
  created_at   DateTime                @default(now())
  resolved_at  DateTime?

  @@index([checklist_id, status])
  @@index([to_user_id, status])
}

/// Solicitud del técnico asignado para continuar un checklist en incumplimiento (aprueba solo Admin).
model ChecklistContinuationRequest {
  id              String                       @id @default(uuid()) @db.Uuid
  checklist_id    String                       @db.Uuid
  checklist       DailyChecklist               @relation(fields: [checklist_id], references: [id], onDelete: Cascade)
  requested_by_id String                       @db.Uuid
  requested_by    User                         @relation("ChecklistContinuationRequester", fields: [requested_by_id], references: [id])
  status          ChecklistContinuationStatus  @default(PENDING)
  note            String?
  resolved_by_id  String?                      @db.Uuid
  resolved_by     User?                        @relation("ChecklistContinuationResolver", fields: [resolved_by_id], references: [id])
  created_at      DateTime                     @default(now())
  resolved_at     DateTime?

  @@index([checklist_id, status])
  @@index([requested_by_id, status])
}

model DailyChecklistRow {
  id              String   @id @default(uuid()) @db.Uuid
  checklist_id    String   @db.Uuid
  checklist       DailyChecklist @relation(fields: [checklist_id], references: [id], onDelete: Cascade)
  activity_name   String
  order           Int      @default(0)
  field_type      String   @default("CHECKBOX")
  line_statuses   Json     @default("{}")
  observations    String?
}

model Holiday {
  id    String   @id @default(uuid()) @db.Uuid
  name  String
  date  DateTime
}

/// Bitácora de cambios relevantes (OT, inventario, permisos).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  created_at DateTime @default(now())
  user_id    String?  @db.Uuid
  user_name  String?
  action     String
  entity     String
  entity_id  String?
  summary    String
  meta       Json?
}

/// Notas personales privadas (solo el dueño las ve).
model PersonalNote {
  id          String    @id @default(uuid()) @db.Uuid
  user_id     String    @db.Uuid
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title       String
  body        String?
  remind_at   DateTime?
  reminded_at DateTime?
  is_done     Boolean   @default(false)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@index([user_id, is_done])
  @@index([remind_at])
}

enum OperationalTaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum OperationalTaskPriority {
  NORMAL
  ALTA
}

/// Pendientes operativos asignables (ligados opcionalmente a OT o activo).
model OperationalTask {
  id            String                @id @default(uuid()) @db.Uuid
  title         String
  body          String?
  created_by_id String                @db.Uuid
  created_by    User                  @relation("OperationalTaskCreator", fields: [created_by_id], references: [id])
  assignee_id   String                @db.Uuid
  assignee      User                  @relation("OperationalTaskAssignee", fields: [assignee_id], references: [id])
  work_order_id String?               @db.Uuid
  work_order    WorkOrder?            @relation(fields: [work_order_id], references: [id], onDelete: SetNull)
  asset_id      String?               @db.Uuid
  asset         Asset?                @relation(fields: [asset_id], references: [id], onDelete: SetNull)
  due_at        DateTime?
  reminded_at   DateTime?
  priority      OperationalTaskPriority @default(NORMAL)
  status        OperationalTaskStatus @default(OPEN)
  completed_at  DateTime?
  completion_note String?
  created_at    DateTime              @default(now())
  updated_at    DateTime              @updatedAt

  @@index([assignee_id, status])
  @@index([created_by_id, status])
  @@index([due_at])
  @@index([work_order_id])
  @@index([asset_id])
  @@index([priority, status])
}

/// Avisos globales visibles para todos; solo Admin crea. Lecturas por usuario.
model GlobalAnnouncement {
  id            String                   @id @default(uuid()) @db.Uuid
  title         String
  body          String?
  image_url     String?
  created_by_id String                   @db.Uuid
  created_by    User                     @relation("AnnouncementCreator", fields: [created_by_id], references: [id])
  is_active     Boolean                  @default(true)
  created_at    DateTime                 @default(now())
  updated_at    DateTime                 @updatedAt
  reads         GlobalAnnouncementRead[]

  @@index([is_active, created_at])
  @@index([created_by_id])
}

model GlobalAnnouncementRead {
  id               String             @id @default(uuid()) @db.Uuid
  announcement_id  String             @db.Uuid
  announcement     GlobalAnnouncement @relation(fields: [announcement_id], references: [id], onDelete: Cascade)
  user_id          String             @db.Uuid
  user             User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  seen_at          DateTime           @default(now())

  @@unique([announcement_id, user_id])
  @@index([user_id])
  @@index([announcement_id])
}

/// Comentarios en el hilo de una OT (quien pueda abrir la OT lee/escribe).
model WorkOrderComment {
  id              String    @id @default(uuid()) @db.Uuid
  work_order_id   String    @db.Uuid
  work_order      WorkOrder @relation(fields: [work_order_id], references: [id], onDelete: Cascade)
  author_id       String    @db.Uuid
  author          User      @relation(fields: [author_id], references: [id], onDelete: Cascade)
  body            String
  attachment_url  String?
  attachment_name String?
  created_at      DateTime  @default(now())

  @@index([work_order_id, created_at])
  @@index([author_id])
}

enum ChatConversationType {
  DIRECT
  GROUP
}

model ChatConversation {
  id            String               @id @default(uuid()) @db.Uuid
  type          ChatConversationType
  title         String?
  created_by_id String               @db.Uuid
  created_by    User                 @relation("ChatConversationCreator", fields: [created_by_id], references: [id])
  created_at    DateTime             @default(now())
  updated_at    DateTime             @updatedAt
  participants  ChatParticipant[]
  messages      ChatMessage[]

  @@index([type, updated_at])
  @@index([created_by_id])
}

model ChatParticipant {
  id              String           @id @default(uuid()) @db.Uuid
  conversation_id String           @db.Uuid
  conversation    ChatConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user_id         String           @db.Uuid
  user            User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  joined_at       DateTime         @default(now())
  last_read_at    DateTime?

  @@unique([conversation_id, user_id])
  @@index([user_id])
}

model ChatMessage {
  id              String           @id @default(uuid()) @db.Uuid
  conversation_id String           @db.Uuid
  conversation    ChatConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  author_id       String           @db.Uuid
  author          User             @relation(fields: [author_id], references: [id], onDelete: Cascade)
  body            String           @default("")
  attachment_url  String?
  attachment_name String?
  created_at      DateTime         @default(now())
  deleted_at      DateTime?

  @@index([conversation_id, created_at])
  @@index([author_id])
}
