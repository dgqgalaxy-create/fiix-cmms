generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRADOR
  GESTIONADOR
  TECNICO
}

enum AssetStatus {
  OPERATIVO
  EN_MANTENIMIENTO
  FUERA_DE_SERVICIO
}

enum WorkOrderStatus {
  PENDIENTE
  EN_PROCESO
  EN_ESPERA
  FINALIZADO
  ANULADO
}

enum Priority {
  URGENTE
  NORMAL
  BAJO
}

enum MaintenanceType {
  SERVICIO
  PREVENTIVO
  CORRECTIVO
}

enum ProductionGroup {
  A
  B
  C
  D
  NA
}

enum UnitOfMeasure {
  PIEZAS
  LITROS
  METROS
  KILOGRAMOS
  KITS
  CAJAS
  PAQUETES
  GALONES
  JUEGOS
  OTROS
}

model User {
  id              String      @id @default(uuid()) @db.Uuid
  name            String
  email           String      @unique
  password_hash   String
  role            Role
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  created_orders  WorkOrder[] @relation("CreatedOrders")
  assigned_orders WorkOrder[] @relation("AssignedOrders")
  inventory_transactions InventoryTransaction[]
}

model Zone {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  work_orders WorkOrder[]
  assets      Asset[]
}

model Asset {
  id              String      @id @default(uuid()) @db.Uuid
  internal_code   String      @unique
  name            String
  brand           String
  model           String
  serial_number   String?
  description     String?
  status          AssetStatus

  image_url       String?
  document_url    String?

  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  zone_id         String?     @db.Uuid
  zone            Zone?       @relation(fields: [zone_id], references: [id])

  work_orders     WorkOrder[]
}

model WorkOrder {
  id               String          @id @default(uuid()) @db.Uuid
  folio            Int             @default(autoincrement())
  title            String
  description      String?

  asset_id         String          @db.Uuid
  asset            Asset           @relation(fields: [asset_id], references: [id])

  zone_id          String?         @db.Uuid
  zone             Zone?           @relation(fields: [zone_id], references: [id])

  priority         Priority        @default(NORMAL)
  maintenance_type MaintenanceType @default(CORRECTIVO)
  machine_stopped  Boolean         @default(false)
  requester_name   String?
  production_group ProductionGroup @default(NA)

  status           WorkOrderStatus
  hold_reason      String?
  started_at          DateTime?
  paused_at           DateTime?
  last_resumed_at     DateTime?
  accumulated_time_ms Int             @default(0)
  resolution_notes    String?
  request_image_url   String?
  before_image_url    String?
  after_image_url     String?

  signature_clean_area String?
  signature_delivery   String?

  created_by_id    String          @db.Uuid
  created_by       User            @relation("CreatedOrders", fields: [created_by_id], references: [id])

  assigned_technicians User[]          @relation("AssignedOrders")

  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  completed_at     DateTime?
}

model KPIGoal {
  id               String          @id @default(uuid()) @db.Uuid
  metricKey        String          @unique
  targetValue      Float
  unit             String?
  updated_at       DateTime        @updatedAt
}

model RolePermission {
  id          String   @id @default(uuid()) @db.Uuid
  role        Role     @unique
  permissions Json
  updated_at  DateTime @updatedAt
}

model ItemCategory {
  id          String   @id @default(uuid()) @db.Uuid
  internal_id String   @unique // Ej. "CAT001"
  name        String
  icon_url    String?
  is_active   Boolean  @default(true)
  
  items       Item[]
}

model ItemLocation {
  id          String   @id @default(uuid()) @db.Uuid
  internal_id String   @unique // Ej. "LOC0001"
  name        String
  icon_url    String?
  is_active   Boolean  @default(true)

  items       Item[]
}

model Vendor {
  id          String   @id @default(uuid()) @db.Uuid
  internal_id String   @unique // Ej. "PROV001"
  name        String
  logo_url    String?
  website_url String?
  phone       String?
  email       String?
  address     String?
  is_active   Boolean  @default(true)

  items       Item[]
}

model Item {
  id                 String          @id @default(uuid()) @db.Uuid
  internal_code      String          @unique // Ej. "MTTO-0001"
  name               String
  description        String?
  image_url          String?
  
  category_id        String?         @db.Uuid
  category           ItemCategory?   @relation(fields: [category_id], references: [id])
  
  vendor_id          String?         @db.Uuid
  vendor             Vendor?         @relation(fields: [vendor_id], references: [id])
  
  location_id        String?         @db.Uuid
  location           ItemLocation?   @relation(fields: [location_id], references: [id])
  
  purchase_cost      Float?
  stock              Float           @default(0)
  minimum_inventory  Float           @default(0)
  is_active          Boolean         @default(true)
  uom                UnitOfMeasure   @default(PIEZAS)

  inventory_transactions InventoryTransaction[]
}

model InventoryTransaction {
  id          String   @id @default(uuid()) @db.Uuid
  
  item_id     String   @db.Uuid
  item        Item     @relation(fields: [item_id], references: [id])
  
  user_id     String   @db.Uuid
  user        User     @relation(fields: [user_id], references: [id])
  
  amount      Float    // Positivo para entradas, negativo para salidas
  reason      String   // Texto libre
  created_at  DateTime @default(now())
}

