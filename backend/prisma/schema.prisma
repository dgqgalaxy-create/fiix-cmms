generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRADOR
  GESTIONADOR
  TECNICO
}

enum AssetStatus {
  OPERATIVO
  EN_MANTENIMIENTO
  FUERA_DE_SERVICIO
}

enum WorkOrderStatus {
  PENDIENTE
  EN_PROCESO
  EN_ESPERA
  FINALIZADO
  ANULADO
}

enum Priority {
  URGENTE
  NORMAL
  BAJO
}

enum MaintenanceType {
  SERVICIO
  PREVENTIVO
  CORRECTIVO
}

enum ProductionGroup {
  A
  B
  C
  D
  NA
}

model UnitOfMeasure {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  is_active Boolean  @default(true)
}

enum FrequencyType {
  DIAS
  SEMANAS
  MESES
  ANUAL
}

model User {
  id              String      @id @default(uuid()) @db.Uuid
  name            String
  email           String      @unique
  password_hash   String
  role            Role
  is_active       Boolean     @default(true)
  last_active     DateTime?
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  created_orders  WorkOrder[] @relation("CreatedOrders")
  assigned_orders WorkOrder[] @relation("AssignedOrders")
  inventory_transactions InventoryTransaction[]
  created_purchase_orders PurchaseOrder[] @relation("CreatedPurchaseOrders")
  notifications   AppNotification[]
  checklist_technician DailyChecklist[] @relation("ChecklistTechnician")
  checklist_leader DailyChecklist[] @relation("ChecklistLeader")

  pattern              TechnicianPattern?
  exceptions           TechnicianException[]
}

model TechnicianPattern {
  id           String   @id @default(uuid()) @db.Uuid
  user_id      String   @db.Uuid @unique
  user         User     @relation(fields: [user_id], references: [id])
  pattern_type String   // "MIXTO", "4X4_ROTATORIO", "4X4_FIJO"
  start_date   DateTime 
  created_at   DateTime @default(now())
}

model TechnicianException {
  id             String   @id @default(uuid()) @db.Uuid
  user_id        String   @db.Uuid
  user           User     @relation(fields: [user_id], references: [id])
  date           DateTime @db.Date
  exception_type String   // "FALTA", "VACACIONES", "PERMISO_CG", "PERMISO_SG", "TIEMPO_EXTRA", "FESTIVO"
  notes          String?  
  created_at     DateTime @default(now())
}

model Requester {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique
  email       String?
  department  String?
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
}

model Zone {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  work_orders WorkOrder[]
  assets      Asset[]
}

model Asset {
  id              String      @id @default(uuid()) @db.Uuid
  internal_code   String      @unique
  name            String
  brand           String
  model           String
  serial_number   String?
  description     String?
  status          AssetStatus

  image_url       String?
  document_url    String?

  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  zone_id         String?     @db.Uuid
  zone            Zone?       @relation(fields: [zone_id], references: [id])
  
  vendor_id       String?     @db.Uuid
  vendor          Vendor?     @relation(fields: [vendor_id], references: [id])
  price           Float?

  work_orders     WorkOrder[]
  maintenance_plans MaintenancePlan[]
}

model WorkOrder {
  id               String          @id @default(uuid()) @db.Uuid
  folio            Int             @default(autoincrement())
  title            String
  description      String?

  asset_id         String          @db.Uuid
  asset            Asset           @relation(fields: [asset_id], references: [id])

  zone_id          String?         @db.Uuid
  zone             Zone?           @relation(fields: [zone_id], references: [id])

  priority         Priority        @default(NORMAL)
  maintenance_type MaintenanceType @default(CORRECTIVO)
  machine_stopped  Boolean         @default(false)
  requester_name   String?
  production_group ProductionGroup @default(NA)

  status           WorkOrderStatus
  hold_reason      String?
  scheduled_date      DateTime?
  due_date            DateTime?
  started_at          DateTime?
  paused_at           DateTime?
  last_resumed_at     DateTime?
  accumulated_time_ms Int             @default(0)
  resolution_notes    String?
  request_image_url   String?
  before_image_url    String?
  after_image_url     String?

  signature_clean_area String?
  signature_delivery   String?

  created_by_id    String          @db.Uuid
  created_by       User            @relation("CreatedOrders", fields: [created_by_id], references: [id])

  assigned_technicians User[]          @relation("AssignedOrders")

  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  completed_at     DateTime?

  maintenance_plan_id String?      @db.Uuid
  maintenance_plan    MaintenancePlan? @relation("GeneratedOrders", fields: [maintenance_plan_id], references: [id])

  failure_problem_id  String?      @db.Uuid
  failure_problem     FailureProblem? @relation(fields: [failure_problem_id], references: [id])

  failure_cause_id    String?      @db.Uuid
  failure_cause       FailureCause?   @relation(fields: [failure_cause_id], references: [id])

  failure_remedy_id   String?      @db.Uuid
  failure_remedy      FailureRemedy?  @relation(fields: [failure_remedy_id], references: [id])
}

model KPIGoal {
  id               String          @id @default(uuid()) @db.Uuid
  metricKey        String          @unique
  targetValue      Float
  unit             String?
  updated_at       DateTime        @updatedAt
}

model RolePermission {
  id          String   @id @default(uuid()) @db.Uuid
  role        Role     @unique
  permissions Json
  updated_at  DateTime @updatedAt
}

model ItemCategory {
  id          String   @id @default(uuid()) @db.Uuid
  internal_id String   @unique // Ej. "CAT001"
  name        String
  icon_url    String?
  is_active   Boolean  @default(true)
  
  items       Item[]
}

model ItemLocation {
  id          String   @id @default(uuid()) @db.Uuid
  internal_id String   @unique // Ej. "LOC0001"
  name        String
  icon_url    String?
  is_active   Boolean  @default(true)

  items       Item[]
}

model Vendor {
  id          String   @id @default(uuid()) @db.Uuid
  internal_id String   @unique // Ej. "PROV001"
  name        String
  logo_url    String?
  website_url String?
  phone       String?
  email       String?
  address     String?
  is_active   Boolean  @default(true)

  items       Item[]
  purchase_orders PurchaseOrder[]
  assets      Asset[]
}

model Item {
  id                 String          @id @default(uuid()) @db.Uuid
  internal_code      String          @unique // Ej. "MTTO-0001"
  name               String
  description        String?
  image_url          String?
  
  category_id        String?         @db.Uuid
  category           ItemCategory?   @relation(fields: [category_id], references: [id])
  
  vendor_id          String?         @db.Uuid
  vendor             Vendor?         @relation(fields: [vendor_id], references: [id])
  
  location_id        String?         @db.Uuid
  location           ItemLocation?   @relation(fields: [location_id], references: [id])
  
  purchase_cost      Float?
  stock              Float           @default(0)
  minimum_inventory  Float           @default(0)
  is_active          Boolean         @default(true)
  uom                String

  inventory_transactions InventoryTransaction[]
  maintenance_plans      PlanItem[]
  purchase_order_items   PurchaseOrderItem[]
}

model InventoryTransaction {
  id          String   @id @default(uuid()) @db.Uuid
  
  item_id     String   @db.Uuid
  item        Item     @relation(fields: [item_id], references: [id])
  
  user_id     String   @db.Uuid
  user        User     @relation(fields: [user_id], references: [id])
  
  amount      Float    // Positivo para entradas, negativo para salidas
  reason      String   // Texto libre
  created_at  DateTime @default(now())
}

model MaintenancePlan {
  id                String          @id @default(uuid()) @db.Uuid
  title             String
  description       String?
  
  asset_id          String          @db.Uuid
  asset             Asset           @relation(fields: [asset_id], references: [id])
  
  frequency_type    FrequencyType
  frequency_value   Int             
  
  last_triggered_at DateTime?
  next_due_date     DateTime
  days_in_advance   Int             @default(3)
  
  is_active         Boolean         @default(true)
  
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  generated_orders  WorkOrder[]     @relation("GeneratedOrders")
  required_items    PlanItem[]      
}

model PlanItem {
  id                  String          @id @default(uuid()) @db.Uuid
  maintenance_plan_id String          @db.Uuid
  maintenance_plan    MaintenancePlan @relation(fields: [maintenance_plan_id], references: [id], onDelete: Cascade)
  
  item_id             String          @db.Uuid
  item                Item            @relation(fields: [item_id], references: [id])
  
  quantity_required   Float
}

enum PurchaseOrderStatus {
  BORRADOR
  APROBADA
  ENVIADA
  RECIBIDA
  CANCELADA
}

model PurchaseOrder {
  id              String   @id @default(uuid()) @db.Uuid
  folio           Int      @default(autoincrement())
  
  vendor_id       String   @db.Uuid
  vendor          Vendor   @relation(fields: [vendor_id], references: [id])
  
  status          PurchaseOrderStatus @default(BORRADOR)
  
  created_by_id   String   @db.Uuid
  created_by      User     @relation("CreatedPurchaseOrders", fields: [created_by_id], references: [id])
  
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  expected_date   DateTime?
  received_at     DateTime?

  items           PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id                 String   @id @default(uuid()) @db.Uuid
  
  purchase_order_id  String   @db.Uuid
  purchase_order     PurchaseOrder @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade)
  
  item_id            String   @db.Uuid
  item               Item     @relation(fields: [item_id], references: [id])
  
  quantity           Float
  unit_cost          Float    // Precio capturado al crear la orden
}

model FailureProblem {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  causes      FailureCause[]
  work_orders WorkOrder[]
}

model FailureCause {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  problem_id  String   @db.Uuid
  problem     FailureProblem @relation(fields: [problem_id], references: [id], onDelete: Cascade)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  remedies    FailureRemedy[]
  work_orders WorkOrder[]
}

model FailureRemedy {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  cause_id    String   @db.Uuid
  cause       FailureCause @relation(fields: [cause_id], references: [id], onDelete: Cascade)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  work_orders WorkOrder[]
}

model SystemSettings {
  id               String   @id @default(uuid()) @db.Uuid
  telegram_enabled   Boolean  @default(true)
  telegram_bot_token String?
  telegram_chat_id   String?
  email_enabled      Boolean  @default(false)
  updated_at       DateTime @updatedAt
}

model AppNotification {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title      String
  message    String
  link       String?
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
}

enum ChecklistStatus {
  DRAFT
  COMPLETED
  REVIEWED
}

model ChecklistActivity {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  order       Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
}

model DailyChecklist {
  id              String   @id @default(uuid()) @db.Uuid
  date            DateTime @unique @db.Date
  technician_id   String   @db.Uuid
  technician      User     @relation("ChecklistTechnician", fields: [technician_id], references: [id])
  leader_id       String?  @db.Uuid
  leader          User?    @relation("ChecklistLeader", fields: [leader_id], references: [id])
  status          ChecklistStatus @default(DRAFT)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  rows            DailyChecklistRow[]
}

model DailyChecklistRow {
  id              String   @id @default(uuid()) @db.Uuid
  checklist_id    String   @db.Uuid
  checklist       DailyChecklist @relation(fields: [checklist_id], references: [id], onDelete: Cascade)
  activity_name   String
  order           Int      @default(0)
  L1_status       String?
  L2_status       String?
  L3_status       String?
  L4_status       String?
  L5_status       String?
  observations    String?
}

model Holiday {
  id    String   @id @default(uuid()) @db.Uuid
  name  String
  date  DateTime
}
