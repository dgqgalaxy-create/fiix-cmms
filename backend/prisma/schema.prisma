generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRADOR
  GESTIONADOR
  TECNICO
}

enum AssetStatus {
  OPERATIVO
  EN_MANTENIMIENTO
  FUERA_DE_SERVICIO
}

enum WorkOrderStatus {
  PENDIENTE
  EN_PROCESO
  EN_ESPERA
  FINALIZADO
}

model User {
  id              String      @id @default(uuid()) @db.Uuid
  name            String
  email           String      @unique
  password_hash   String
  role            Role
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  created_orders  WorkOrder[] @relation("CreatedOrders")
  assigned_orders WorkOrder[] @relation("AssignedOrders")
}

model Asset {
  id              String      @id @default(uuid()) @db.Uuid
  internal_code   String      @unique
  name            String
  brand           String
  model           String
  serial_number   String?
  description     String?
  status          AssetStatus

  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  work_orders     WorkOrder[]
}

model WorkOrder {
  id               String          @id @default(uuid()) @db.Uuid
  title            String
  description      String?

  asset_id         String          @db.Uuid
  asset            Asset           @relation(fields: [asset_id], references: [id])

  status           WorkOrderStatus
  hold_reason      String?
  paused_at        DateTime?
  resolution_notes String?
  before_image_url String?
  after_image_url  String?

  created_by_id    String          @db.Uuid
  created_by       User            @relation("CreatedOrders", fields: [created_by_id], references: [id])

  assigned_to_id   String?         @db.Uuid
  assigned_to      User?           @relation("AssignedOrders", fields: [assigned_to_id], references: [id])

  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  completed_at     DateTime?
}
