# ============================================================
# GTZ CMMS — plantilla del .env RAÍZ (solo instalación Docker)
# ============================================================
# Uso:
#   cp .env.example .env
#   # edita .env con tus claves reales
#   sudo docker compose up -d --build
#
# `docker compose` lee este archivo automáticamente y sustituye las referencias
# ${VARIABLE} del docker-compose.yml.
#
# IMPORTANTE — este archivo SÍ se versiona, el .env NO:
#   .gitignore contiene «.env», así que tu .env real nunca se sube a GitHub y
#   sobrevive a «git restore .» + «git pull» + «docker compose up -d --build».
#   Nunca escribas secretos reales en ESTE archivo (.env.example).
#
# En Ubuntu nativo (sin Docker) estas variables van en backend/.env:
# ver backend/.env.example.

# ------------------------------------------------------------
# Obligatorias en producción
# ------------------------------------------------------------

# Contraseña del PostgreSQL del compose. Cámbiala por una fuerte.
DB_PASSWORD=cambia_esta_clave_de_postgres

# Secreto para firmar los JWT de sesión. Genera uno largo y aleatorio:
#   openssl rand -base64 48
JWT_SECRET=cambia_este_secreto_jwt

# Puerto publicado en el host (la app escucha en el 3000 dentro del contenedor).
# Cloudflare Tunnel apunta a http://localhost:3000 (o al que pongas aquí).
PORT=3000

# ------------------------------------------------------------
# Dominio público / proxy inverso (Cloudflare Tunnel, nginx, Tailscale Funnel)
# ------------------------------------------------------------

# Orígenes EXTRA permitidos para CORS y para Socket.IO, separados por comas.
# Añade aquí el hostname público EXACTO con el que entras desde el navegador,
# incluyendo el esquema (https://). Sin esto verás «CORS: origen no permitido»
# y la app puede quedarse en pantalla blanca al entrar por el dominio.
#
# Ejemplo de una sola instalación:
#   CORS_ORIGINS="https://cmms.ejemplo.com"
#
# Ejemplo con varios orígenes (coma-separados; se admiten tantos como necesites):
#   CORS_ORIGINS="https://cmms.ejemplo.com,https://otro.ejemplo.com"
#
# Ejemplo usado en producción (Cloudflare Tunnel + dominio propio):
#   CORS_ORIGINS="https://lpet.gtzcmms.com"
#
# Si lo dejas vacío NO se rompe nada: siguen permitidos por defecto
# localhost / 127.0.0.1 / [::1], la LAN privada (10.x, 172.16-31.x, 192.168.x),
# el rango CGNAT de Tailscale (100.x) y cualquier host *.ts.net.
CORS_ORIGINS=

# Alias de CORS_ORIGINS (mismo efecto). Si defines las dos, gana CORS_ORIGINS.
# ALLOWED_ORIGINS="https://cmms.ejemplo.com"

# ------------------------------------------------------------
# Esquema de base de datos al arrancar
# ------------------------------------------------------------

# Pon 1 para NO aplicar el esquema al arrancar (por ejemplo si vas a restaurar
# un respaldo sobre una base vacía).
SKIP_DB_PUSH=0

# Emergencia. Déjalo en 0. Con 1 permites que «prisma db push» borre columnas o
# tablas para cuadrar el esquema; con 0 el arranque falla y conservas los datos.
# ALLOW_DB_PUSH_DATA_LOSS=0

# ------------------------------------------------------------
# Opcionales
# ------------------------------------------------------------

# Notificaciones Web Push PWA. Genéralas con: npx web-push generate-vapid-keys
# (si migras de servidor, copia las MISMAS claves o cada usuario tendrá que
# volver a activar las notificaciones en su teléfono).
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:mantenimiento@tu-dominio.com"

# Google Drive (fotos en importación CSV/Sheets).
# Recomendado: configúralo desde la app en Opciones de Desarrollador → Integraciones.
# El .env solo es respaldo si el campo guardado en BD queda vacío.
# GOOGLE_DRIVE_API_KEY=""
# GOOGLE_DRIVE_ITEMS_FOLDER="https://drive.google.com/drive/folders/ID_INVENTARIO"
# GOOGLE_DRIVE_VENDORS_FOLDER="https://drive.google.com/drive/folders/ID_PROVEEDORES"
# GOOGLE_DRIVE_WO_FOLDER="https://drive.google.com/drive/folders/ID_ORDENES"

# Telegram (alertas). Recomendado: configúralo desde la app.
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""

# ------------------------------------------------------------
# Asistente de Inteligencia Artificial (Nivel 2 con Datos en Vivo) — Preview v1.72.0-preview.1
# ------------------------------------------------------------
# Proveedor compatible con OpenAI. La configuración recomendada es OpenRouter
# con modelos :free, para que el asistente no genere cobros.
# IMPORTANTE: OpenRouter no publica una variante ":free" de DeepSeek V4.1 Flash;
# deepseek/deepseek-v4.1-flash es de pago (costo muy bajo por consulta).
#
# Alternativa DeepSeek gratuita (OpenCode Zen):
#   AI_BASE_URL="https://opencode.ai/inference/openai/v1"
#   AI_MODEL="deepseek-v4.1-flash-free"
#   Requiere una API key de OpenCode Console. Según su documentación, los modelos
#   free están pensados para usarse desde OpenCode y pueden no aceptar clientes externos.
AI_ENABLED=true
AI_API_KEY=""
AI_BASE_URL="https://openrouter.ai/api/v1"
AI_MODEL="nvidia/nemotron-3.5-lightning:free"
# Respaldo si el modelo principal no tiene crédito, cuota o está saturado.
# Debe usar el mismo AI_BASE_URL y soportar tool calling. También es gratuito.
AI_FALLBACK_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"
# Límites opcionales (valores por defecto del código)
# AI_MAX_TOKENS=1400
# AI_TIMEOUT_MS=45000
# AI_MAX_TOOL_ROUNDS=4
# AI_TIMEZONE="America/Mexico_City"
# AI_APP_URL="https://cmms.ejemplo.com"
# AI_DEBUG=false
